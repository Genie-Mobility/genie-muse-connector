{
  "tools": [
    {
      "name": "get_delivery_quote",
      "description": "Quote configured service area, route estimate and test price; quote is not a booking.",
      "inputSchema": {
        "properties": {
          "pickup_address": {
            "title": "Pickup Address",
            "type": "string"
          },
          "dropoff_address": {
            "title": "Dropoff Address",
            "type": "string"
          },
          "package_description": {
            "title": "Package Description",
            "type": "string"
          },
          "requested_ready_time": {
            "format": "date-time",
            "title": "Requested Ready Time",
            "type": "string"
          },
          "handoff_type": {
            "title": "Handoff Type",
            "type": "string"
          },
          "idempotency_key": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]{1,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instructions"
          },
          "handoff_instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Handoff Instructions"
          }
        },
        "required": [
          "pickup_address",
          "dropoff_address",
          "package_description",
          "requested_ready_time",
          "handoff_type",
          "idempotency_key"
        ],
        "title": "get_delivery_quoteArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },

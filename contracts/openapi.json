          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "restaurant_confirmation",
          "restaurant_order_reference",
          "pickup_name",
          "ready_at"
        ],
        "title": "PickupBody"
      },
      "QuoteRequest": {
        "properties": {
          "pickup_address": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Pickup Address"
          },
          "dropoff_address": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Dropoff Address"
          },
          "package_description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Package Description"
          },
          "requested_ready_time": {
            "type": "string",
            "format": "date-time",
            "title": "Requested Ready Time"
          },
          "handoff_type": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Handoff Type"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000

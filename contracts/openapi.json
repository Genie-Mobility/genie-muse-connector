          }
        },
        "type": "object",
        "required": [
          "earliest",
          "latest",
          "simulation"
        ],
        "title": "EstimatedWindow"
      },
      "PickupBody": {
        "properties": {
          "restaurant_confirmation": {
            "type": "boolean",
            "const": true,
            "title": "Restaurant Confirmation"
          },
          "restaurant_order_reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Restaurant Order Reference"
          },
          "pickup_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Pickup Name"
          },
          "ready_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ready At"
          },
          "pickup_code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Code"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "pickup_contact": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],

  "components": {
    "schemas": {
      "CancelBody": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "CancelBody"
      },
      "ConfirmRequest": {
        "properties": {
          "reservation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reservation Id"
          },
          "user_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "User Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reservation_id",
          "user_confirmed"
        ],
        "title": "ConfirmRequest"
      },
      "DeliveryEvent": {
        "properties": {
          "event_id": {
            "type": "integer",
            "title": "Event Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_pickup_details",
              "queued",
              "in_transit",
              "completed",
              "cancelled"
            ],
            "title": "Status"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "status",
          "occurred_at",
          "simulation"
        ],
        "title": "DeliveryEvent"
      },
      "DeliveryResponse": {
        "properties": {
          "delivery_id": {
            "type": "string",
            "format": "uuid",
            "title": "Delivery Id"
          },
          "reservation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Reservation Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_pickup_details",
              "queued",
              "in_transit",
              "completed",
              "cancelled"
            ],
            "title": "Status"
          },
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation"
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "simulated_authorized",
              "simulated_captured",
              "simulated_voided"
            ],
            "title": "Payment Status"
          },
          "price_cents": {
            "type": "integer",
            "title": "Price Cents"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "pickup_details_received": {
            "type": "boolean",
            "title": "Pickup Details Received"
          },
          "ready_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ready At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "cancellation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancellation Reason"
          }
        },
        "type": "object",
        "required": [
          "delivery_id",
          "reservation_id",
          "status",
          "simulation",
          "payment_status",
          "price_cents",
          "currency",
          "pickup_details_received",
          "ready_at",
          "created_at",
          "updated_at",
          "cancellation_reason"
        ],
        "title": "DeliveryResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {

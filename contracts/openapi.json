          },
          "simulation": {
            "type": "boolean",
            "const": true,
            "title": "Simulation"
          },
          "price_cents": {
            "type": "integer",
            "title": "Price Cents"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "eligible": {
            "type": "boolean",
            "title": "Eligible"
          },
          "eligibility": {
            "type": "string",
            "const": "simulated",
            "title": "Eligibility"
          },
          "eligibility_note": {
            "type": "string",
            "title": "Eligibility Note"
          },
          "estimated_delivery_at": {
            "type": "string",
            "format": "date-time",
            "title": "Estimated Delivery At"
          },
          "estimated_window": {
            "$ref": "#/components/schemas/EstimatedWindow"
          },
          "eta_note": {
            "type": "string",
            "title": "Eta Note"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "cancellation_terms": {
            "type": "string",
            "title": "Cancellation Terms"
          },
          "terms": {
            "$ref": "#/components/schemas/QuoteTerms"
          }
        },
        "type": "object",
        "required": [
          "quote_id",
          "status",
          "simulation",
          "price_cents",
          "currency",
          "eligible",
          "eligibility",
          "eligibility_note",
          "estimated_delivery_at",
          "estimated_window",
          "eta_note",
          "expires_at",
          "cancellation_terms",
          "terms"
        ],
        "title": "QuoteResponse"
      },
      "QuoteTerms": {
